<?xml version="1.0" encoding="utf-8"?>
<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TodoDesk · 待办"
        Width="880"
        Height="740"
        MinWidth="400"
        MinHeight="400"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Opacity="0">

    <Window.Resources>

        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>

        <Style x:Key="SoftFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1.4"
                                CornerRadius="7" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Ellipse Margin="-2"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="1.4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="{DynamicResource ToolTipTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolTipBackgroundBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBody"
                                Width="4"
                                Margin="0,2,3,2"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}" />

        <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WindowControlGlyphBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource WindowControlGlyphHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowControlPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WindowControlGlyphBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ClosePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Foreground" Value="{DynamicResource RowIconBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IconButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource IconButtonHoverGlyphBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource IconButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteRowIconButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource RowIconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuietTextButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QuietHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource QuietPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskCheckButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CircleFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Width="26" Height="26" Background="Transparent">
                            <Grid Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="Ring"
                                         Fill="Transparent"
                                         Stroke="{DynamicResource CheckRingBrush}"
                                         StrokeThickness="1.2" />
                                <Path x:Name="Glyph"
                                      Width="20"
                                      Height="20"
                                      Stretch="None"
                                      Data="M 4.5,10 L 8.2,13.7 L 15.5,6.3"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource OnAccentBrush}"
                                      StrokeThickness="1.65"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource CheckRingHoverBrush}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.7" />
                                <Setter TargetName="Ring" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="1.2" />
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCompleted}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentHoverBrush}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontSize" Value="14.2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="IBeam" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CompletedTextBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InlineEditBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14.2" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource EditFieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditFieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.18" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="EditChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="EditChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeSegmentStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Segment"
                                Margin="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource SegmentSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Segment" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12.2" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FocusVisualStyle" Value="{StaticResource SoftFocusVisual}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type RadioButton}">
                <Border x:Name="FilterChrome" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource QuietHoverBrush}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="FilterChrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A quiet, custom title bar. The whole surface is draggable. -->
        <Grid x:Name="TitleBar"
              Grid.Row="0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Border Width="20"
                        Height="20"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="6">
                    <Path Width="12"
                          Height="12"
                          Data="M 1,6 L 4.5,9.5 L 11,2.5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Stretch="None"
                          Stroke="{DynamicResource OnAccentBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Border>
                <TextBlock Margin="9,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleWordmarkBrush}"
                           Text="TodoDesk" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="SettingsButton"
                        Style="{StaticResource WindowButtonStyle}"
                        Margin="1,0,8,0"
                        ToolTip="设置"
                        AutomationProperties.Name="设置">
                    <Path Width="14"
                          Height="14"
                          Data="M 1,4 L 13,4 M 1,10 L 13,10 M 5,1 L 5,7 M 10,8 L 10,14"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.15"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}"
                        ToolTip="最小化"
                        AutomationProperties.Name="最小化">
                    <Path Width="10"
                          Height="10"
                          Data="M 0,5 L 10,5"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.05"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" ToolTip="最大化" AutomationProperties.Name="最大化">
                    <Path x:Name="MaximizeGlyph" Width="10" Height="10" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="1.05"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButtonStyle}"
                        ToolTip="关闭"
                        AutomationProperties.Name="关闭">
                    <Path Width="10"
                          Height="10"
                          Data="M 0,0 L 10,10 M 10,0 L 0,10"
                          Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          StrokeThickness="1.05"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="MainContent" Grid.Row="1" Margin="30,26,30,24">
            <Grid MaxWidth="640"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock x:Name="DateText"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryBrush}" />
                    <StackPanel x:Name="StatusPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Ellipse x:Name="StatusDot"
                                 Width="5"
                                 Height="5"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="StatusText"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="Hero" Grid.Row="1" Margin="0,15,0,0">
                    <TextBlock x:Name="HeroTitle" Text="把事情，一件件做好。" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeroSubtitle" Margin="0,10,0,0" Text="留一点空间，专注眼前的小事。" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" />
                </StackPanel>

                <Grid x:Name="ComposerHost" Grid.Row="2" Height="56" Margin="0,26,0,0">
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="13"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18"
                                              Direction="270"
                                              Opacity="0.045"
                                              ShadowDepth="3"
                                              Color="#2A241B"
                                              RenderingBias="Quality" />
                        </Border.Effect>
                    </Border>
                    <Border x:Name="Composer"
                            Background="{DynamicResource CardBrush}"
                            CornerRadius="13">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ComposerBorderBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ComposerFocusBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                    <Grid Margin="11,0,13,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AddButton"
                                Width="28"
                                Height="28"
                                VerticalAlignment="Center"
                                Focusable="True"
                                FocusVisualStyle="{StaticResource CircleFocusVisual}"
                                ToolTip="添加待办（Enter）"
                                AutomationProperties.Name="添加待办">
                            <Button.Template>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="AddChrome"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="14">
                                        <Path Width="10"
                                              Height="10"
                                              Data="M 0,5 L 10,5 M 5,0 L 5,10"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource OnAccentBrush}"
                                              StrokeThickness="1.5"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AddChrome" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="AddChrome" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Grid.Column="2" Text="Enter ↵" Margin="12,0,2,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TertiaryBrush}" IsHitTestVisible="False"/>
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock x:Name="ComposerPlaceholder"
                                       VerticalAlignment="Center"
                                       Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       FontSize="14.2"
                                       Foreground="{DynamicResource TertiaryBrush}"
                                       Text="下一件想做的事…" />
                            <TextBox x:Name="NewTaskInput"
                                     MaxLength="200"
                                     Padding="0"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource AccentBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     SelectionOpacity="0.18"
                                     FontSize="14.2"
                                     Foreground="{DynamicResource InkBrush}"
                                     AutomationProperties.Name="新的待办内容" />
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <Grid x:Name="TaskArea" Grid.Row="3" Margin="0,22,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="45"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Content="全部" Tag="all" IsChecked="True" GroupName="TaskFilter" Style="{StaticResource FilterStyle}" AutomationProperties.Name="查看全部任务"/>
                            <RadioButton x:Name="FilterActive" Content="待办" Tag="active" GroupName="TaskFilter" Style="{StaticResource FilterStyle}" AutomationProperties.Name="查看待办任务"/>
                            <RadioButton x:Name="FilterCompleted" Content="已完成" Tag="completed" GroupName="TaskFilter" Style="{StaticResource FilterStyle}" AutomationProperties.Name="查看已完成任务"/>
                        </StackPanel>
                        <TextBlock x:Name="ListCountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="2,12,2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StorageStatusDot" Width="5" Height="5" Fill="{DynamicResource SecondaryBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="StorageStatusText" Text="正在读取本地数据…" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,10,0"/>
                            <ProgressBar x:Name="TaskProgress" Width="60" Height="4" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HairlineBrush}" BorderThickness="0" AutomationProperties.Name="任务完成百分比">
                                <ProgressBar.Template><ControlTemplate TargetType="{x:Type ProgressBar}">
                                    <Grid x:Name="PART_Track" ClipToBounds="True">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2"/>
                                    </Grid>
                                </ControlTemplate></ProgressBar.Template>
                            </ProgressBar>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                            CornerRadius="16"
                            IsHitTestVisible="False">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32"
                                              Direction="270"
                                              Opacity="0.055"
                                              ShadowDepth="7"
                                              Color="#2A241B"
                                              RenderingBias="Quality" />
                        </Border.Effect>
                    </Border>

                    <Border Grid.Row="1" x:Name="ListCard"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">

                    <Grid>
                        <ScrollViewer x:Name="TaskScroll"
                                      CanContentScroll="False"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      Focusable="False"
                                      Padding="0,4,0,4">
                            <StackPanel>
                                <StackPanel x:Name="ActiveList" />

                                <Grid x:Name="CompletedSection"
                                      Margin="0,9,0,2"
                                      Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="14,0,8,0">
                                        <Button x:Name="CompletedToggleButton" HorizontalAlignment="Left" Style="{StaticResource QuietTextButtonStyle}" ToolTip="折叠或展开已完成任务">
                                            <TextBlock x:Name="CompletedHeaderText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}"/>
                                        </Button>
                                        <Button x:Name="ClearCompletedButton"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource QuietTextButtonStyle}"
                                                Content="清除"
                                                ToolTip="清除全部已完成事项"
                                                AutomationProperties.Name="清除全部已完成事项" />
                                    </Grid>

                                    <StackPanel x:Name="CompletedList" Grid.Row="1" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <Canvas Width="54" Height="54" HorizontalAlignment="Center">
                                <Ellipse Width="54"
                                         Height="54"
                                         Fill="{DynamicResource EmptyFillBrush}"
                                         Stroke="{DynamicResource EmptyStrokeBrush}"
                                         StrokeThickness="1" />
                                <Path Data="M 18,27 L 24,33 L 36,21"
                                      Stroke="{DynamicResource EmptyCheckBrush}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Canvas>
                            <TextBlock x:Name="EmptyTitle" Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="还没有待办" />
                            <TextBlock x:Name="EmptyDescription" Margin="0,7,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryBrush}"
                                       Text="写下一件小事，给今天一个轻盈的开始。" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="Toast"
              Grid.RowSpan="2"
              Panel.ZIndex="40"
              Margin="24,0,24,26"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Opacity="0"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="8" />
            </Grid.RenderTransform>

            <Border Background="{DynamicResource ToastBackgroundBrush}"
                    CornerRadius="10"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22"
                                      Direction="270"
                                      Opacity="0.2"
                                      ShadowDepth="5"
                                      Color="#000000"
                                      RenderingBias="Quality" />
                </Border.Effect>
            </Border>

            <Border Padding="14,8,8,8"
                    Background="{DynamicResource ToastBackgroundBrush}"
                    CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastText"
                           MaxWidth="430"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           Foreground="{DynamicResource ToastTextBrush}"
                           TextWrapping="Wrap" />
                <Button x:Name="ToastUndoButton"
                        Margin="10,0,0,0"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource ToastUndoBrush}"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Content="撤销"
                        Visibility="Collapsed"
                        AutomationProperties.Name="撤销上一步">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="UndoChrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="UndoChrome" Property="Background" Value="{DynamicResource ToastUndoHoverBackgroundBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ToastUndoHoverForegroundBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="30"
              Opacity="0"
              Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle"
              AutomationProperties.Name="设置">
            <Border x:Name="SettingsScrim"
                    Background="{DynamicResource SettingsScrimBrush}" />

            <Grid x:Name="SettingsCardRoot"
                  MaxWidth="460"
                  Margin="16"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsCardTransform" Y="10" />
                </Grid.RenderTransform>

                <Border Background="{DynamicResource SettingsCardBrush}"
                        CornerRadius="18"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="36"
                                          Direction="270"
                                          Opacity="0.16"
                                          ShadowDepth="9"
                                          Color="#000000"
                                          RenderingBias="Quality" />
                    </Border.Effect>
                </Border>

                <Border Background="{DynamicResource SettingsCardBrush}"
                        BorderBrush="{DynamicResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="26,22,26,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="设置" />
                            <Button x:Name="SettingsCloseButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowIconButtonStyle}"
                                    ToolTip="关闭设置"
                                    AutomationProperties.Name="关闭设置">
                                <Path Width="10"
                                      Height="10"
                                      Data="M 0,0 L 10,10 M 10,0 L 0,10"
                                      Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                      StrokeThickness="1.05"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,22,0,0">
                            <TextBlock FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TertiaryBrush}"
                                       Text="外观" />
                            <Border Height="38"
                                    Margin="0,10,0,0"
                                    Background="{DynamicResource SegmentTrackBrush}"
                                    CornerRadius="10">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="ThemeSystemButton"
                                                 Content="跟随系统"
                                                 Tag="system"
                                                 GroupName="ThemeSegment"
                                                 Style="{StaticResource ThemeSegmentStyle}"
                                                 AutomationProperties.Name="外观跟随系统" />
                                    <RadioButton x:Name="ThemeLightButton"
                                                 Content="浅色"
                                                 Tag="light"
                                                 GroupName="ThemeSegment"
                                                 Style="{StaticResource ThemeSegmentStyle}"
                                                 AutomationProperties.Name="使用浅色外观" />
                                    <RadioButton x:Name="ThemeDarkButton"
                                                 Content="深色"
                                                 Tag="dark"
                                                 GroupName="ThemeSegment"
                                                 Style="{StaticResource ThemeSegmentStyle}"
                                                 AutomationProperties.Name="使用深色外观" />
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,24,0,0">
                            <TextBlock FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TertiaryBrush}"
                                       Text="保存位置" />
                            <Border Height="40"
                                    Margin="0,10,0,0"
                                    Padding="12,0"
                                    Background="{DynamicResource SettingsFieldBrush}"
                                    BorderBrush="{DynamicResource SettingsFieldBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <TextBlock x:Name="DataPathText"
                                           VerticalAlignment="Center"
                                           FontSize="12.2"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </Border>

                            <Grid Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ChangeDataFolderButton"
                                            Content="更改位置"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            AutomationProperties.Name="更改数据保存位置" />
                                    <Button x:Name="ResetDataFolderButton"
                                            Margin="8,0,0,0"
                                            Content="恢复默认"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            AutomationProperties.Name="恢复默认数据保存位置" />
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontSize="11.2"
                                           Foreground="{DynamicResource TertiaryBrush}"
                                           Text="todos.json" />
                            </Grid>

                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11.2"
                                       Foreground="{DynamicResource TertiaryBrush}"
                                       Text="数据仅保存在本机，不会同步或上传。" />
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,24,0,0">
                            <TextBlock x:Name="SettingsVersionText"
                                       FontSize="10.8"
                                       Foreground="{DynamicResource TertiaryBrush}" />
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="10.8"
                                       Foreground="{DynamicResource TertiaryBrush}"
                                       Text="本地 · 离线" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
