<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="TodoDesk" Language="2052" Version="1.3.2" Manufacturer="宋培恩" Codepage="936" UpgradeCode="{B4C0A0A6-5A65-4D56-9C9B-1E3C2F5D7A11}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 TodoDesk。" Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="..\app\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/paulwatcegt-ui/TodoDesk" />
    <Property Id="ARPPUBLISHER" Value="宋培恩" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\TodoDesk" Name="InstallFolder" Type="raw" Win64="yes" />
    </Property>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" Before="InstallValidate" Sequence="execute" />
    <UIRef Id="WixUI_InstallDir" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="..\dist\installer\license.rtf" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs"><Directory Id="INSTALLFOLDER" Name="TodoDesk" /></Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="AppFiles" Guid="{D5D49C80-73FC-49F7-863A-F55C5E23BA13}" Win64="yes">
        <RegistryValue Root="HKCU" Key="Software\TodoDesk" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <File Id="TodoDeskExe" Name="TodoDesk.exe" Source="..\dist\native\DaiBan.exe">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="TodoDesk" Description="TodoDesk · 本地待办清单" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="no" />
          <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="TodoDesk" Description="TodoDesk · 本地待办清单" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" Advertise="no" />
        </File>
        <File Id="LicenseFile" Name="LICENSE" Source="..\LICENSE" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      </Component>
    </DirectoryRef>
    <Feature Id="MainFeature" Title="TodoDesk" Level="1"><ComponentRef Id="AppFiles" /></Feature>
  </Product>
</Wix>
